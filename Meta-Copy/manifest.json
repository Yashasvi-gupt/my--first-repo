{
  "manifest_version": 3,
  "name": "Meta Copy",
  "version": "1.0.0",
  "description": "Copy a webpage's meta title and meta description with one click.",
  "permissions": ["activeTab", "scripting", "tabs", "windows"],
  "action": {
    "default_title": "Meta Copy",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
